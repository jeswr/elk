{
  "@context": [
    "https://www.w3.org/ns/solid/oidc-context.jsonld",
    {
      "fedapp": "https://w3id.org/jeswr/fed#",
      "acl": "http://www.w3.org/ns/auth/acl#",
      "as": "https://www.w3.org/ns/activitystreams#",
      "sectors": "https://w3id.org/jeswr/sectors/",
      "App": "fedapp:App",
      "sector": { "@id": "fedapp:sector", "@type": "@id" },
      "access": { "@id": "fedapp:access", "@type": "@id", "@container": "@set" },
      "consumes": { "@id": "fedapp:consumes", "@type": "@id", "@container": "@set" },
      "produces": { "@id": "fedapp:produces", "@type": "@id", "@container": "@set" }
    }
  ],
  "client_id": "https://elk.jeswr.org/clientid.jsonld",
  "client_name": "Elk (Solid edition)",
  "client_uri": "https://elk.jeswr.org/",
  "logo_uri": "https://elk.jeswr.org/elk.svg",
  "redirect_uris": ["https://elk.jeswr.org/", "https://elk.jeswr.org/callback.html"],
  "grant_types": ["authorization_code", "refresh_token"],
  "response_types": ["code"],
  "scope": "openid profile offline_access webid",
  "token_endpoint_auth_method": "none",

  "@type": "App",
  "sector": "https://w3id.org/jeswr/sectors/social#sector",
  "access": ["acl:Read", "acl:Write", "acl:Control"],
  "produces": ["https://w3id.org/jeswr/sectors/social/shapes#NoteShape", "as:Note"],
  "consumes": ["https://w3id.org/jeswr/sectors/social/shapes#NoteShape", "as:Note"]
}
